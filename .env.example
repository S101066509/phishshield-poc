# 複製為根目錄 .env，填妥端點與模型後啟動。程式會自動讀取，不需要 export 或 source。
# A、B 各自是一行 JSON 陣列；多組端點由左至右依序備援。
# 每組只需填 endpoint、model、api_key，以及 thinking。
# thinking：false 關閉思考、true 使用中等思考、null 沿用模型服務預設。
# output_token_parameter可選：預設max_completion_tokens；Ollama 0.40.x請在該組JSON加
# "output_token_parameter":"max_tokens"，確保服務端收到輸出上限。不是輸出數量設定。
# 本機範例 endpoint：http://127.0.0.1:11434/v1；外部服務使用 HTTPS API base URL。
# Compose沿用本檔；容器啟動時將HTTP loopback模型位址轉向主機，實際.env不會改寫。
# 容器的資料庫位址由Compose指定postgres:5432；原生執行仍使用下方DATABASE_URL。
# 不需要認證時 api_key 留空。金鑰只保存在後端，請勿公開實際 .env。
PHISHSHIELD_LLM_ENDPOINTS_A='[{"endpoint":"","model":"","api_key":"","thinking":null}]'
PHISHSHIELD_LLM_ENDPOINTS_B='[{"endpoint":"","model":"","api_key":"","thinking":null}]'

# 常用執行上限：以下三項單位為秒；輸出上限單位為 token。
PHISHSHIELD_LLM_CALL_TIMEOUT_SECONDS=10
PHISHSHIELD_LLM_TOTAL_TIMEOUT_SECONDS=30
PHISHSHIELD_ANALYSIS_TIMEOUT_SECONDS=45
# A提取與B判斷各自設定；不是兩項相加。未設定的階段才回退舊共用值（預設2048）。
PHISHSHIELD_LLM_MAX_OUTPUT_TOKENS_A=2048
PHISHSHIELD_LLM_MAX_OUTPUT_TOKENS_B=2048

# 預設低溫與固定seed，適用A／B及其所有備援端點；低溫不保證分類正確或逐位元重現。
PHISHSHIELD_LLM_TEMPERATURE=0
PHISHSHIELD_LLM_SEED=42
# 明確停用seed時設為null（省略seed請求欄位）；不要用空字串。

# 資料庫與保存：本機 compose.yaml 的 PostgreSQL 預設連線。
PHISHSHIELD_DATABASE_URL=postgresql+psycopg://phishshield@127.0.0.1:55432/phishshield
PHISHSHIELD_DATABASE_SCHEMA=public
# 保存回覆異常時，查回原紀錄的額外期限（秒）。
PHISHSHIELD_RECONCILIATION_TIMEOUT_SECONDS=1

# 進階重試設定：MAX_ATTEMPTS包含第一次，適用暫時連線／容量／可恢復服務故障。
# 讀取／寫入逾時、單次生成deadline或來源不明的timeout不重抽，也不換端點重抽。
PHISHSHIELD_LLM_MAX_ATTEMPTS=3
PHISHSHIELD_LLM_RETRY_DELAY_SECONDS=0.25
PHISHSHIELD_LLM_RETRY_BACKOFF_MULTIPLIER=2
PHISHSHIELD_LLM_RETRY_MAX_DELAY_SECONDS=4
PHISHSHIELD_LLM_RETRY_JITTER_RATIO=0.2
PHISHSHIELD_LLM_CONNECTION_RESET_TIMEOUT_SECONDS=2

# 資源上限：以下單位為 bytes。
PHISHSHIELD_LLM_MAX_INPUT_BYTES=256000
# 完整 system/data/schema/訊息包裝的 bytes 上界；與 data 上限分開。
PHISHSHIELD_LLM_MAX_REQUEST_BYTES=256000
# 僅在已確認實際 runner 容量時設定；未設定為未知，不採模型宣稱最大值。
# PHISHSHIELD_LLM_EFFECTIVE_CONTEXT_TOKENS=32768
PHISHSHIELD_LLM_MAX_OUTPUT_BYTES=65536
PHISHSHIELD_MAX_REQUEST_BYTES=2100000
